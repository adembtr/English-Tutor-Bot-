      "parameters": {
        "jsCode": "// Gemini'den gelen açıklamayı al\nconst imageDescription = $input.first().json.text || $input.first().json.output || '';\n\n// Switch'ten gelen orijinal mesajı al\nconst originalMessage = $('Switch').first().json.message;\nconst caption = originalMessage.caption || '';\nconst chat = originalMessage.chat;\n\n// Mesajı oluştur\nconst combinedMessage = caption \n  ? `[User sent a photo with caption: \"${caption}\"]\\n[Image description: ${imageDescription}]`\n  : `[User sent a photo]\\n[Image description: ${imageDescription}]`;\n\nreturn [{\n  json: {\n    message: {\n      text: combinedMessage,\n      chat: chat\n    }\n  }\n}];"
      },
